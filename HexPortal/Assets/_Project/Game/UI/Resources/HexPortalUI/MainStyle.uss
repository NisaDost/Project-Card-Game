/* Graybox HUD. Reference 1920x1080 matched by HEIGHT: a 360-430 dp tall phone maps 1080 units to its height,
   so 173 units ~ 64 dp. Every touch target is >= 173 units on its short side unless noted (UX-01). */
.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
Label { color: rgb(245, 245, 250); -unity-font-style: bold; }

/* ---------- Top strip: icons + numbers only (UX-04) ---------- */
.top-strip { position: absolute; left: 0; right: 0; top: 0; height: 104px; flex-direction: row; align-items: center;
    justify-content: space-between; padding-left: 20px; padding-right: 20px; background-color: rgba(10, 12, 20, 0.78); }
.top-group { flex-direction: row; align-items: center; }
.top-group.center { position: absolute; left: 30%; right: 30%; justify-content: center; }
.top-group.right { justify-content: flex-end; min-height: 100px; padding-left: 20px; border-radius: 16px; }
.top-group.right:active { background-color: rgba(255, 255, 255, 0.12); }
.stat { font-size: 50px; margin: 0 14px; -unity-text-align: middle-center; }
.stat.own { color: rgb(140, 185, 255); }
.stat.opp { color: rgb(255, 140, 140); }
.banner { font-size: 44px; padding: 6px 26px; border-radius: 14px; background-color: rgba(60, 80, 140, 0.95); margin: 0 8px; }
.banner.mine { background-color: rgb(40, 140, 70); }
.banner.theirs { background-color: rgb(150, 50, 60); }
.banner.event { background-color: rgba(210, 115, 20, 0.95); }

/* ---------- Side columns ---------- */
.side-col { position: absolute; top: 120px; bottom: 16px; }
.left-col { left: 16px; width: 300px; }
.right-col { right: 16px; width: 392px; align-items: stretch; }
.spacer { flex-grow: 1; }

.meter { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 10px 14px; margin-bottom: 14px;
    border-radius: 18px; border-width: 5px; }
.mana-meter { background-color: rgba(30, 60, 160, 0.9); border-color: rgb(120, 170, 255); }
.energy-meter { background-color: rgba(150, 105, 10, 0.9); border-color: rgb(255, 215, 70); }
.meter-icon { font-size: 64px; width: 84px; -unity-text-align: middle-center; }
.mana-icon { color: rgb(150, 200, 255); }
.energy-icon { color: rgb(255, 230, 90); }
.meter-text { font-size: 80px; flex-grow: 1; -unity-text-align: middle-left; }
.meter-caption { font-size: 26px; width: 100%; color: rgb(200, 220, 255); display: none; }
.pips { flex-direction: row; width: 100%; height: 30px; margin-top: 6px; }
.pip { width: 27px; height: 26px; margin-right: 4px; border-radius: 6px; }
.mana-pip { background-color: rgb(130, 190, 255); }
.energy-pip { background-color: rgb(255, 220, 80); }
.pip.off { background-color: rgba(255, 255, 255, 0.18); }
.timer-row { flex-direction: row; margin-bottom: 14px; }
.timer { font-size: 44px; padding: 8px 12px; margin-right: 8px; background-color: rgba(0, 0, 0, 0.55); border-radius: 12px;
    -unity-text-align: middle-center; }
.timer.bank { font-size: 32px; color: rgb(200, 200, 210); }
.event-log { font-size: 25px; max-height: 260px; overflow: hidden; -unity-font-style: normal; white-space: normal; margin-top: 14px; padding: 10px;
    border-radius: 12px; background-color: rgba(0, 0, 0, 0.5); color: rgb(225, 225, 235); }

/* ---------- Buttons: clear on / off / pressed states (UX-01) ---------- */
.btn { min-height: 173px; min-width: 173px; font-size: 40px; margin: 6px 0; border-radius: 22px; padding: 6px;
    background-color: rgb(55, 95, 200); color: rgb(255, 255, 255); border-width: 5px; border-color: rgb(150, 190, 255);
    white-space: normal; -unity-font-style: bold;
    transition-property: scale; transition-duration: 0.08s; }
.btn:hover { background-color: rgb(75, 120, 230); }
.btn:active { scale: 0.93 0.93; background-color: rgb(110, 155, 255); border-color: rgb(255, 255, 255); }
.btn.big { width: 640px; min-height: 173px; font-size: 46px; margin: 12px; }
.btn.quest { min-height: 173px; font-size: 44px; background-color: rgb(110, 75, 170); border-color: rgb(200, 170, 255); }
.btn.half { flex-grow: 1; margin: 6px; }
.btn.ok { background-color: rgb(40, 150, 75); border-color: rgb(140, 240, 160); }
.market-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.btn.market { width: 188px; height: 188px; font-size: 30px; margin: 4px 0; padding: 4px; -unity-text-align: middle-center; }
.btn.market.picked { border-color: rgb(255, 230, 80); border-width: 9px; }
.btn.end { min-height: 210px; font-size: 54px; background-color: rgb(35, 150, 70); border-color: rgb(150, 240, 170); }
.btn.end:active { background-color: rgb(70, 200, 105); border-color: rgb(255, 255, 255); }
.btn.overwatch { background-color: rgb(130, 65, 165); border-color: rgb(220, 170, 255); font-size: 46px; }
.btn.selected { border-color: rgb(255, 230, 80); border-width: 9px; background-color: rgb(70, 110, 60); }

.prompt { position: absolute; left: 340px; right: 430px; top: 120px; font-size: 38px; -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.6); border-radius: 14px; padding: 8px; white-space: normal; }
.notice { position: absolute; left: 600px; right: 600px; top: 10px; max-height: 86px; font-size: 32px; overflow: hidden; -unity-text-align: middle-center;
    padding: 6px 12px; border-radius: 14px; background-color: rgba(20, 20, 30, 0.85); display: none; white-space: normal; }
.notice.bad { background-color: rgba(170, 30, 30, 0.92); }
.notice.good { background-color: rgba(30, 130, 60, 0.92); }
.toast { position: absolute; left: 340px; right: 430px; bottom: 300px; font-size: 44px; -unity-text-align: middle-center;
    padding: 12px; border-radius: 16px; background-color: rgba(120, 40, 40, 0.95); display: none; white-space: normal; }

/* ---------- Hand: icon, name and cost only (UX-07); description on long press ---------- */
.hand { position: absolute; left: 330px; right: 420px; bottom: 6px; height: 240px; flex-direction: row;
    justify-content: center; align-items: flex-end; }
.card { width: 186px; height: 222px; margin: 0 5px; padding: 8px; border-radius: 20px; border-width: 9px;
    background-color: rgb(238, 235, 225); border-color: rgb(160, 160, 160); align-items: center; justify-content: center;
    transition-property: translate, scale; transition-duration: 0.08s; }
.card:active { scale: 0.95 0.95; }
.card Label { color: rgb(30, 30, 40); white-space: normal; }
.card.selected { translate: 0 -40px; border-color: rgb(255, 225, 0); }
.card.unplayable { background-color: rgb(150, 150, 150); opacity: 0.75; }
.card-cost { position: absolute; left: -12px; top: -12px; width: 76px; height: 76px; border-radius: 38px; font-size: 46px;
    -unity-text-align: middle-center; background-color: rgb(50, 100, 225); border-width: 4px; border-color: white; }
.card .card-cost { color: white; }
.card-icon { font-size: 76px; -unity-text-align: middle-center; margin-top: 10px; }
.card-name { font-size: 32px; -unity-text-align: middle-center; }
.dragging { position: absolute; display: none; opacity: 0.85; }
.hand-group { flex-direction: row; align-items: flex-end; margin: 0 14px; }
.card.over-budget { background-color: rgb(150, 150, 150); opacity: 0.7; }
.card-note { position: absolute; bottom: 4px; left: 0; right: 0; font-size: 22px; -unity-text-align: middle-center;
    color: rgb(170, 20, 20); }

/* ---------- UX-11 info panel (left; a tap closes it) ---------- */
.info-panel { position: absolute; left: 16px; top: 470px; width: 560px; bottom: 236px; padding: 16px 20px;
    background-color: rgb(16, 20, 34); border-radius: 20px; border-width: 4px; border-color: rgb(120, 140, 200);
    display: none; overflow: hidden; }
.info-head { flex-direction: row; align-items: center; margin-bottom: 6px; }
.info-icon { font-size: 48px; width: 64px; -unity-text-align: middle-center; }
.info-title { font-size: 34px; flex-shrink: 1; white-space: normal; }
.info-text { font-size: 24px; white-space: normal; -unity-font-style: normal; color: rgb(230, 232, 240); }

/* ---------- Popups and screens ---------- */
.popup { position: absolute; left: 25%; right: 25%; top: 16%; padding: 30px; background-color: rgba(20, 24, 40, 0.97);
    border-radius: 22px; border-width: 5px; border-color: rgb(120, 140, 200); display: none; }
.popup-text { font-size: 38px; white-space: normal; margin-bottom: 18px; -unity-font-style: normal; }
.popup-row { flex-direction: row; }

.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center;
    background-color: rgba(8, 10, 18, 0.85); display: none; }
.screen.opaque { background-color: rgb(14, 17, 28); }
.screen-title { font-size: 70px; margin-bottom: 26px; }
.screen-title.huge { font-size: 130px; }
.screen-sub { font-size: 50px; margin: 10px; }
.menu-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 1400px; }
.options { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 92%; }
.option { width: 520px; min-height: 230px; margin: 10px; font-size: 36px; }

/* ---------- Board overlay: unit tags and floating numbers ---------- */
.unit-tag { position: absolute; width: 92px; translate: -50% -100%; align-items: center;
    border-bottom-width: 5px; border-radius: 8px; }
.unit-tag.ghost { opacity: 0.45; }
.unit-tag.dim { opacity: 0.65; }
.hp-bar { width: 92px; height: 30px; border-radius: 8px; background-color: rgb(25, 25, 30); border-width: 3px;
    border-color: rgb(0, 0, 0); overflow: hidden; justify-content: center; }
.hp-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(60, 220, 80); }
.hp-text { font-size: 26px; color: white; -unity-text-align: middle-center; -unity-text-outline-width: 2px;
    -unity-text-outline-color: black; }
.chips { flex-direction: row; justify-content: center; margin-top: 2px; }
.chip { font-size: 22px; padding: 0 4px; margin: 0 2px; border-radius: 8px; -unity-text-align: middle-center; }
.chip-atk { background-color: rgb(170, 40, 40); }
.chip-buff { background-color: rgb(30, 140, 60); }
.chip-debuff { background-color: rgb(120, 40, 160); }
.chip-watch { background-color: rgb(210, 170, 20); color: rgb(30, 30, 30); }
.float-label { position: absolute; font-size: 56px; translate: -50% -50%; -unity-text-align: middle-center;
    -unity-text-outline-width: 3px; -unity-text-outline-color: black; }
.float-label.big { font-size: 84px; }

.err-counter { position: absolute; left: 10px; bottom: 4px; font-size: 26px; padding: 2px 10px; border-radius: 8px;
    background-color: rgba(20, 110, 40, 0.85); display: none; }
.err-counter.has-errors { background-color: rgba(200, 30, 30, 0.95); }

/* Off state last so it wins over every button variant: grey, low-contrast text; a tap shows the reason (toast). */
.btn.off, .btn.market.off, .btn.end.off, .btn.quest.off, .btn.big.off { background-color: rgb(50, 52, 60); border-color: rgb(80, 82, 92);
    color: rgb(125, 127, 136); }
.btn.off:hover, .btn.market.off:hover, .btn.end.off:hover { background-color: rgb(58, 60, 68); }
.btn.off:active, .btn.market.off:active, .btn.end.off:active { scale: 0.97 0.97; background-color: rgb(80, 50, 50); border-color: rgb(220, 90, 90); }
.btn.end.with-reason { font-size: 34px; }
/* UX-12 selection mode: the hand slides down and fades so the bottom board row stays visible. */
.hand { transition-property: translate, opacity; transition-duration: 0.18s; }
.hand.selecting { translate: 0 45%; opacity: 0.45; }
