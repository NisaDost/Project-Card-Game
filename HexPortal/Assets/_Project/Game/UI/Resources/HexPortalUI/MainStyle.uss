/* Graybox HUD (v4.0 compact layout, see docs/PROGRESS.md "HUD layout (v4.0)"). Reference 1920x1080 matched by
   HEIGHT: a 360-430 dp tall landscape phone gives 2.5-3 units per dp, so 144 units >= 48 dp (UX-01). Visuals may be
   smaller than that; their touch target (.btn / .hit) never is. The "hud" root is inset by Screen.safeArea in code. */
.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
Label { color: rgb(245, 245, 250); -unity-font-style: bold; }

/* ---------- Corners: small read-only gauges (top) and thumb-zone controls (bottom) ---------- */
.corner { position: absolute; }
.top-left { left: 10px; top: 8px; flex-direction: row; align-items: center; }
.top-right { right: 0; top: 0; flex-direction: row; align-items: flex-start; }
.bottom-left { left: 10px; bottom: 8px; width: 250px; flex-direction: column; align-items: flex-start; }
.bottom-right { right: 10px; bottom: 8px; width: 304px; flex-direction: column; align-items: stretch; }
.top-center { position: absolute; left: 32%; right: 32%; top: 8px; flex-direction: row; justify-content: center; align-items: center; }

.chip-stat { font-size: 30px; height: 50px; padding: 0 12px; margin: 0 6px 0 0; border-radius: 12px;
    background-color: rgba(10, 12, 20, 0.78); -unity-text-align: middle-center; }
.chip-stat.own { color: rgb(140, 185, 255); }
.chip-stat.opp { color: rgb(255, 140, 140); }
.timer.bank { font-size: 24px; color: rgb(200, 200, 210); }
.banner { font-size: 28px; height: 50px; padding: 0 18px; border-radius: 12px; background-color: rgba(60, 80, 140, 0.95); margin: 0 4px;
    -unity-text-align: middle-center; }
.banner.mine { background-color: rgb(40, 140, 70); }
.banner.theirs { background-color: rgb(150, 50, 60); }
.banner.event { background-color: rgba(210, 115, 20, 0.95); }
.event-log { position: absolute; left: 10px; top: 66px; width: 390px; font-size: 20px; max-height: 128px; overflow: hidden;
    -unity-font-style: normal; white-space: normal; padding: 6px 8px; border-radius: 10px; background-color: rgba(0, 0, 0, 0.45);
    color: rgb(225, 225, 235); }

/* Padded touch target: the element is >= 144 units, its visible ".face" is smaller. */
.hit { min-width: 144px; min-height: 144px; margin: 0; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0);
    align-items: center; justify-content: center; }
.btn.hit, .btn.hit:hover, .btn.hit:active { background-color: rgba(0, 0, 0, 0); border-width: 0; scale: 1 1; }
.face { align-items: center; justify-content: center; border-radius: 14px; -unity-text-align: middle-center;
    transition-property: scale; transition-duration: 0.08s; }
.hit:active .face { scale: 0.92 0.92; }
.opp-hit { flex-direction: row; padding: 0 6px; }
.opp-face { flex-direction: row; padding: 4px; border-radius: 14px; background-color: rgba(10, 12, 20, 0.35); }
.opp-face .chip-stat { margin: 0 2px; }
.pause .face { width: 80px; height: 80px; font-size: 34px; background-color: rgb(55, 95, 200); border-width: 3px; border-color: rgb(150, 190, 255); }
.quest .face { width: 200px; height: 72px; font-size: 28px; background-color: rgb(110, 75, 170); border-width: 3px; border-color: rgb(200, 170, 255); }
.btn.quest { width: 200px; justify-content: flex-end; padding: 0 0 6px 0; }

.meter { flex-direction: row; flex-wrap: wrap; align-items: center; min-height: 60px; width: 250px; padding: 2px 10px; margin-top: 8px;
    border-radius: 14px; border-width: 3px; }
.mana-meter { background-color: rgba(30, 60, 160, 0.9); border-color: rgb(120, 170, 255); }
.energy-meter { background-color: rgba(150, 105, 10, 0.9); border-color: rgb(255, 215, 70); }
.meter-icon { font-size: 32px; width: 40px; -unity-text-align: middle-center; }
.mana-icon { color: rgb(150, 200, 255); }
.energy-icon { color: rgb(255, 230, 90); }
.meter-text { font-size: 42px; min-width: 58px; -unity-text-align: middle-left; }
.meter-caption { font-size: 18px; width: 100%; color: rgb(200, 220, 255); display: none; }
.pips { flex-direction: row; flex-grow: 1; flex-shrink: 1; flex-wrap: wrap; width: 120px; }
.pip { width: 14px; height: 14px; margin: 1px 3px 1px 0; border-radius: 4px; }
.mana-pip { background-color: rgb(130, 190, 255); }
.energy-pip { background-color: rgb(255, 220, 80); }
.pip.off { background-color: rgba(255, 255, 255, 0.18); }
.spacer { flex-grow: 1; }

/* ---------- Buttons: clear on / off / pressed states (UX-01); every button is a >= 144-unit target ---------- */
.btn { min-height: 144px; min-width: 144px; font-size: 32px; margin: 4px 0; border-radius: 18px; padding: 4px;
    background-color: rgb(55, 95, 200); color: rgb(255, 255, 255); border-width: 4px; border-color: rgb(150, 190, 255);
    white-space: normal; -unity-font-style: bold;
    transition-property: scale; transition-duration: 0.08s; }
.btn:hover { background-color: rgb(75, 120, 230); }
.btn:active { scale: 0.93 0.93; background-color: rgb(110, 155, 255); border-color: rgb(255, 255, 255); }
.btn.big { width: 620px; min-height: 150px; font-size: 42px; margin: 10px; }
.btn.half { flex-grow: 1; margin: 6px; }
.btn.ok { background-color: rgb(40, 150, 75); border-color: rgb(140, 240, 160); }
.section-title { font-size: 22px; color: rgb(190, 200, 225); margin: 0 4px 2px 4px; -unity-text-align: middle-left; }
/* T-04 draw call: a banner above the Market and a glowing frame while the mandatory draw is pending. */
.draw-call { font-size: 34px; padding: 6px; margin-bottom: 6px; border-radius: 12px; color: rgb(40, 30, 0);
    background-color: rgb(255, 215, 60); -unity-text-align: middle-center; display: none; }
.market-box { padding: 4px; border-radius: 16px; border-width: 4px; border-color: rgba(0, 0, 0, 0); background-color: rgba(10, 12, 20, 0.55); }
.market-box.call { border-color: rgb(255, 215, 60); background-color: rgba(130, 100, 10, 0.65); }
.market-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.btn.market { width: 144px; height: 144px; min-width: 144px; min-height: 144px; font-size: 22px; margin: 2px 0; padding: 4px;
    -unity-text-align: middle-center; border-radius: 14px; }
.btn.end { min-height: 144px; font-size: 40px; margin-top: 8px; background-color: rgb(35, 150, 70); border-color: rgb(150, 240, 170); }
.btn.end:active { background-color: rgb(70, 200, 105); border-color: rgb(255, 255, 255); }
.btn.overwatch { min-height: 144px; background-color: rgb(130, 65, 165); border-color: rgb(220, 170, 255); font-size: 34px; margin-bottom: 8px; }
.btn.selected { border-color: rgb(255, 230, 80); border-width: 8px; background-color: rgb(70, 110, 60); }

.prompt { position: absolute; left: 420px; right: 420px; top: 118px; font-size: 26px; -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.6); border-radius: 12px; padding: 6px; white-space: normal; }
.notice { position: absolute; left: 30%; right: 30%; top: 64px; max-height: 50px; font-size: 26px; overflow: hidden; -unity-text-align: middle-center;
    padding: 4px 10px; border-radius: 12px; background-color: rgba(20, 20, 30, 0.85); display: none; white-space: normal; }
.notice.bad { background-color: rgba(170, 30, 30, 0.92); }
.notice.good { background-color: rgba(30, 130, 60, 0.92); }
.toast { position: absolute; left: 420px; right: 420px; bottom: 230px; font-size: 30px; -unity-text-align: middle-center;
    padding: 10px; border-radius: 14px; background-color: rgba(120, 40, 40, 0.95); display: none; white-space: normal; }

/* ---------- Hand (UX-07): every part has its own row and nothing is absolutely positioned, so cost, name, stats and
   the budget note never overlap (affordable, unaffordable, over budget). ---------- */
.hand { position: absolute; left: 276px; right: 326px; bottom: 4px; height: 184px; flex-direction: row;
    justify-content: center; align-items: flex-end; }
.card { width: 146px; height: 172px; margin: 0 4px; padding: 4px 5px; border-radius: 16px; border-width: 6px;
    background-color: rgb(238, 235, 225); border-color: rgb(160, 160, 160); flex-direction: column; align-items: stretch;
    justify-content: flex-start; overflow: hidden; transition-property: translate, scale; transition-duration: 0.08s; }
.card:active { scale: 0.95 0.95; }
.card Label { color: rgb(30, 30, 40); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; padding: 0; }
.card.selected { translate: 0 -30px; border-color: rgb(255, 225, 0); }
.card.unplayable { background-color: rgb(165, 165, 165); opacity: 0.8; }
.card.over-budget { background-color: rgb(165, 165, 165); opacity: 0.8; }
.card-top { flex-direction: row; align-items: center; height: 54px; flex-shrink: 0; }
.card-cost { width: 44px; height: 44px; min-width: 44px; border-radius: 22px; font-size: 28px; -unity-text-align: middle-center;
    background-color: rgb(50, 100, 225); border-width: 3px; border-color: white; flex-shrink: 0; }
.card .card-cost { color: white; }
.card-icon { flex-grow: 1; font-size: 44px; -unity-text-align: middle-center; }
.card-name { font-size: 20px; height: 28px; flex-shrink: 0; -unity-text-align: middle-center; }
.card-stats { font-size: 16px; height: 24px; flex-shrink: 0; -unity-text-align: middle-center; }
.card .card-stats { -unity-font-style: normal; }
.card-note { font-size: 15px; height: 22px; flex-shrink: 0; -unity-text-align: middle-center; }
.card .card-note { color: rgb(170, 20, 20); }
.dragging { position: absolute; display: none; opacity: 0.85; }
.hand-group { flex-direction: row; align-items: flex-end; margin: 0 10px; }

/* ---------- UX-11 info panel (left; display only) ---------- */
.info-panel { position: absolute; left: 10px; top: 204px; width: 460px; bottom: 320px; padding: 12px 16px;
    background-color: rgba(20, 24, 40, 0.95); border-radius: 18px; border-width: 4px; border-color: rgb(120, 140, 200);
    display: none; overflow: hidden; }
.info-head { flex-direction: row; align-items: center; margin-bottom: 8px; padding-bottom: 6px;
    border-bottom-width: 2px; border-color: rgba(120, 140, 200, 0.5); }
.info-icon { font-size: 38px; width: 50px; -unity-text-align: middle-center; }
.info-title { font-size: 32px; flex-shrink: 1; white-space: normal; }
.info-text { font-size: 22px; white-space: normal; -unity-font-style: normal; color: rgb(230, 232, 240); }

/* ---------- Popups and screens ---------- */
.popup { position: absolute; left: 26%; right: 26%; top: 13%; max-height: 80%; padding: 24px 30px; background-color: rgba(20, 24, 40, 0.98);
    border-radius: 22px; border-width: 5px; border-color: rgb(120, 140, 200); display: none; }
.popup-head { flex-direction: row; align-items: center; justify-content: space-between; min-height: 96px;
    margin-bottom: 16px; padding-bottom: 10px; border-bottom-width: 3px; border-color: rgba(120, 140, 200, 0.5); }
.popup-title { font-size: 46px; -unity-text-align: middle-left; flex-grow: 1; }
.btn.close { min-width: 200px; min-height: 144px; font-size: 36px; margin: 0; }
.popup-scroll { flex-shrink: 1; }
.popup-text { font-size: 30px; white-space: normal; margin-bottom: 12px; -unity-font-style: normal; }
.popup-row { flex-direction: row; }

.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center;
    background-color: rgba(8, 10, 18, 0.85); display: none; }
.screen.opaque { background-color: rgb(14, 17, 28); }
.screen-title { font-size: 70px; margin-bottom: 26px; }
.screen-title.huge { font-size: 130px; }
.screen-sub { font-size: 50px; margin: 10px; }
.menu-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 1400px; }
.options { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 92%; }
.option { width: 520px; min-height: 230px; margin: 10px; font-size: 36px; }

/* ---------- Board overlay: unit tags and floating numbers ---------- */
.unit-tag { position: absolute; width: 92px; translate: -50% -100%; align-items: center;
    border-bottom-width: 5px; border-radius: 8px; }
.unit-tag.ghost { opacity: 0.45; }
.unit-tag.dim { opacity: 0.65; }
.hp-bar { width: 92px; height: 30px; border-radius: 8px; background-color: rgb(25, 25, 30); border-width: 3px;
    border-color: rgb(0, 0, 0); overflow: hidden; justify-content: center; }
.hp-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(60, 220, 80); }
.hp-text { font-size: 26px; color: white; -unity-text-align: middle-center; -unity-text-outline-width: 2px;
    -unity-text-outline-color: black; }
.chips { flex-direction: row; justify-content: center; margin-top: 2px; }
.chip { font-size: 22px; padding: 0 4px; margin: 0 2px; border-radius: 8px; -unity-text-align: middle-center; }
.chip-atk { background-color: rgb(170, 40, 40); }
.chip-buff { background-color: rgb(30, 140, 60); }
.chip-debuff { background-color: rgb(120, 40, 160); }
.chip-watch { background-color: rgb(210, 170, 20); color: rgb(30, 30, 30); }
.float-label { position: absolute; font-size: 56px; translate: -50% -50%; -unity-text-align: middle-center;
    -unity-text-outline-width: 3px; -unity-text-outline-color: black; }
.float-label.big { font-size: 84px; }

.err-counter { position: absolute; right: 12px; top: 150px; font-size: 22px; padding: 2px 10px; border-radius: 8px;
    background-color: rgba(20, 110, 40, 0.85); display: none; }
.err-counter.has-errors { background-color: rgba(200, 30, 30, 0.95); }

/* Off state last so it wins over every button variant: grey, low-contrast text; a tap shows the reason (toast). */
.btn.off, .btn.market.off, .btn.end.off, .btn.big.off { background-color: rgb(50, 52, 60); border-color: rgb(80, 82, 92);
    color: rgb(125, 127, 136); }
.btn.market.off { opacity: 0.55; }
.btn.off:hover, .btn.market.off:hover, .btn.end.off:hover { background-color: rgb(58, 60, 68); }
.btn.off:active, .btn.market.off:active, .btn.end.off:active { scale: 0.97 0.97; background-color: rgb(80, 50, 50); border-color: rgb(220, 90, 90); }
.btn.end.with-reason { font-size: 24px; }
/* UX-12 selection mode: the hand slides down and fades so the bottom board row stays visible. */
.hand { transition-property: translate, opacity; transition-duration: 0.18s; }
.hand.selecting { translate: 0 45%; opacity: 0.45; }
/* UX-08 tutorial: hint bubble and a glow on the UI element the step is about. */
.tutorial-bubble { position: absolute; left: 280px; width: 400px; top: 204px; flex-direction: column; align-items: stretch;
    padding: 10px 14px; border-radius: 16px; background-color: rgba(25, 30, 60, 0.78); border-width: 4px;
    border-color: rgba(255, 220, 90, 0.9); }
.tutorial-row { flex-direction: row; justify-content: flex-end; margin-top: 8px; }
.tutorial-text { font-size: 24px; white-space: normal; color: white; }
.tutorial-btn { min-width: 144px; min-height: 144px; font-size: 30px; margin-left: 10px; }
.chip-range { background-color: rgb(40, 90, 170); }
/* UX-15 pause menu */
.pause-panel { top: 6%; left: 32%; right: 32%; }
.pause-panel .btn { min-height: 144px; margin: 6px 0; font-size: 36px; }
.btn.big.quit { background-color: rgb(120, 45, 55); border-color: rgb(230, 140, 150); }
.chip-spot { color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: black; }
/* v4.0: Overwatch and Torch side by side (UX-02 unit actions); D-05 Market refresh under the slots. */
.unit-actions { flex-direction: row; }
.unit-actions > .btn.overwatch { flex-grow: 1; flex-basis: 0; font-size: 28px; }
.btn.torch { background-color: rgb(190, 110, 30); border-color: rgb(255, 210, 140); margin-left: 6px; }
.btn.refresh { min-height: 64px; height: 64px; font-size: 24px; margin-top: 4px; background-color: rgb(40, 110, 140); border-color: rgb(140, 220, 255); }
.btn.refresh.off { background-color: rgb(50, 52, 60); border-color: rgb(80, 82, 92); opacity: 0.55; }
.bearer-hint { color: rgb(255, 160, 250); font-size: 22px; }
.btn.market { transition-property: scale, rotate; transition-duration: 0.25s; }
.btn.market.flip { scale: 0.2 1; }
