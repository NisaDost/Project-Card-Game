<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Landscape, reference 1920x1080 matched by height (GDD UX-04). A 360-430 dp tall phone gives 2.5-3 units per dp,
         so a 48 dp touch target (UX-01) is >= 144 units (.hit / .btn min size). Text is filled in from Strings.cs. -->
    <ui:VisualElement name="board-hit" class="fill" />
    <ui:VisualElement name="overlay" class="fill" picking-mode="Ignore" />

    <!-- v4.0 compact HUD (PROGRESS "HUD layout (v4.0)"): small read-only gauges in the four corners, the touch controls
         in the bottom thumb zones. "hud" is inset by Screen.safeArea from code (GameUi.ApplySafeArea). -->
    <ui:VisualElement name="hud" class="fill" picking-mode="Ignore">
        <ui:VisualElement name="top-left" class="corner top-left" picking-mode="Ignore">
            <ui:Label name="own-tower" class="chip-stat own" />
            <ui:Label name="round" class="chip-stat" />
            <ui:Label name="timer" class="chip-stat timer" />
            <ui:Label name="timer-bank" class="chip-stat timer bank" />
        </ui:VisualElement>
        <ui:VisualElement name="top" class="top-center" picking-mode="Ignore">
            <ui:Label name="turn-banner" class="banner" />
            <ui:Label name="event-banner" class="banner event" />
        </ui:VisualElement>
        <ui:VisualElement name="top-right" class="corner top-right" picking-mode="Ignore">
            <ui:VisualElement name="opp-info" class="hit opp-hit">
                <ui:VisualElement class="face opp-face" picking-mode="Ignore">
                    <ui:Label name="opp-tower" class="chip-stat opp" picking-mode="Ignore" />
                    <ui:Label name="opp-hand" class="chip-stat" picking-mode="Ignore" />
                    <ui:Label name="opp-quests" class="chip-stat" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="pause-btn" class="btn hit pause" />
        </ui:VisualElement>
        <ui:Label name="event-log" class="event-log" picking-mode="Ignore" />

        <ui:VisualElement name="left" class="corner bottom-left" picking-mode="Ignore">
            <ui:Button name="quest-btn" class="btn hit quest" />
            <ui:VisualElement class="meter mana-meter" picking-mode="Ignore">
                <ui:Label name="mana-icon" class="meter-icon mana-icon" />
                <ui:Label name="mana-text" class="meter-text" />
                <ui:VisualElement name="mana-pips" class="pips" />
                <ui:Label name="mana-caption" class="meter-caption" />
            </ui:VisualElement>
            <ui:VisualElement class="meter energy-meter" picking-mode="Ignore">
                <ui:Label name="energy-icon" class="meter-icon energy-icon" />
                <ui:Label name="energy-text" class="meter-text" />
                <ui:VisualElement name="energy-pips" class="pips" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="right" class="corner bottom-right" picking-mode="Ignore">
            <ui:Button name="overwatch-btn" class="btn overwatch" />
            <ui:Label name="draw-call" class="draw-call" picking-mode="Ignore" />
            <ui:VisualElement name="market-box" class="market-box" picking-mode="Ignore">
                <ui:Label name="market-title" class="section-title" picking-mode="Ignore" />
                <ui:VisualElement class="market-grid" picking-mode="Ignore">
                    <ui:Button name="market-0" class="btn market" />
                    <ui:Button name="market-1" class="btn market" />
                    <ui:Button name="market-2" class="btn market" />
                    <ui:Button name="blind-btn" class="btn market blind" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="end-btn" class="btn end" />
        </ui:VisualElement>

        <ui:Label name="prompt" class="prompt" picking-mode="Ignore" />
        <ui:Label name="notice" class="notice" picking-mode="Ignore" />
        <ui:VisualElement name="hand" class="hand" picking-mode="Ignore">
            <!-- UX-04 (v3.0): traps left, characters middle, buff/debuff right -->
            <ui:VisualElement name="hand-traps" class="hand-group traps" picking-mode="Ignore" />
            <ui:VisualElement name="hand-chars" class="hand-group chars" picking-mode="Ignore" />
            <ui:VisualElement name="hand-buffs" class="hand-group buffs" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- UX-11 (v3.0): info panel on the left for a tapped unit, tower or card (display only) -->
        <ui:VisualElement name="info-panel" class="info-panel">
            <ui:VisualElement class="info-head" picking-mode="Ignore">
                <ui:Label name="info-icon" class="info-icon" picking-mode="Ignore" />
                <ui:Label name="info-title" class="info-title" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="info-text" class="info-text" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="toast" class="toast" picking-mode="Ignore" />
    </ui:VisualElement>
    <!-- Outside the inset HUD: positioned in root panel coordinates under the finger -->
    <ui:VisualElement name="drag-card" class="card dragging" picking-mode="Ignore" />

    <!-- UX-16: quests, pause and info are mutually exclusive panels with the same header layout -->
    <ui:VisualElement name="quest-panel" class="popup">
        <ui:VisualElement class="popup-head">
            <ui:Label name="quest-title" class="popup-title" />
            <ui:Button name="quest-close" class="btn close" />
        </ui:VisualElement>
        <ui:ScrollView class="popup-scroll">
            <ui:Label name="quest-text" class="popup-text" />
        </ui:ScrollView>
    </ui:VisualElement>
    <ui:VisualElement name="pause-panel" class="popup pause-panel">
        <ui:VisualElement class="popup-head">
            <ui:Label name="pause-title" class="popup-title" />
        </ui:VisualElement>
        <ui:Button name="pause-resume" class="btn big" />
        <ui:Button name="pause-timer" class="btn big" />
        <ui:Button name="pause-vibration" class="btn big" />
        <ui:Button name="pause-sound" class="btn big" />
        <ui:Button name="pause-menu" class="btn big" />
    </ui:VisualElement>
    <ui:VisualElement name="confirm-panel" class="popup">
        <ui:Label name="confirm-text" class="popup-text" />
        <ui:VisualElement class="popup-row">
            <ui:Button name="confirm-cancel" class="btn half" />
            <ui:Button name="confirm-ok" class="btn half ok" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="screen-quests" class="screen">
        <ui:Label name="quests-title" class="screen-title" />
        <ui:VisualElement name="quest-options" class="options" />
        <ui:Button name="quests-confirm" class="btn big" />
    </ui:VisualElement>
    <ui:VisualElement name="screen-passive" class="screen">
        <ui:Label name="passive-title" class="screen-title" />
        <ui:VisualElement name="passive-options" class="options" />
    </ui:VisualElement>
    <ui:VisualElement name="screen-handoff" class="screen opaque">
        <ui:Label name="handoff-title" class="screen-title" />
        <ui:Label name="handoff-player" class="screen-sub" />
        <ui:Label name="handoff-tap" class="screen-sub" />
    </ui:VisualElement>
    <ui:VisualElement name="screen-result" class="screen opaque">
        <ui:Label name="result-title" class="screen-title" />
        <ui:Label name="result-reason" class="screen-sub" />
        <ui:Button name="result-menu" class="btn big" />
    </ui:VisualElement>
    <ui:VisualElement name="screen-menu" class="screen opaque">
        <ui:Label name="menu-title" class="screen-title huge" />
        <ui:VisualElement class="menu-grid">
            <ui:Button name="menu-ai-easy" class="btn big" />
            <ui:Button name="menu-ai-normal" class="btn big" />
            <ui:Button name="menu-seat" class="btn big" />
            <ui:Button name="menu-ai-timer" class="btn big" />
            <ui:Button name="menu-hotseat" class="btn big" />
            <ui:Button name="menu-timer" class="btn big" />
            <ui:Button name="menu-tutorial" class="btn big" />
            <ui:Button name="menu-quit" class="btn big quit" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:Label name="err-counter" class="err-counter" picking-mode="Ignore" />
</ui:UXML>
