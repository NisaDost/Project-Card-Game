<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles Core against Unity's API surface (netstandard2.1, C# 9) so .NET 5+ only APIs fail here, not in Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>HexPortal.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/_Project/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
